{
  "schemaVersion": 1,
  "kind": "krineon-owned-web-accounts",
  "confirmedBy": "replace-with-researcher-id",
  "environmentOwner": "researcher-owned-bug-bounty-trial",
  "ownedFixtureNamespace": "replace-with-owned-fixture-namespace",
  "programRulesDate": "2099-01-01",
  "validUntil": "2099-01-02T00:00:00Z",
  "ownedAccountsOnly": true,
  "callbackOriginIds": [],
  "advanced": {
    "allowBoundedConcurrency": true,
    "allowHttpDesynchronization": false
  },
  "accounts": [
    {
      "id": "owner-admin",
      "credentialType": "form-login",
      "login": {
        "usernameRef": "secret://owner-admin-username",
        "usernameVersion": "owner-admin-username-v1",
        "passwordRef": "secret://owner-admin-password",
        "passwordVersion": "owner-admin-password-v1",
        "startPath": "",
        "usernameSelector": "",
        "passwordSelector": "",
        "submitSelector": "",
        "successSelector": "",
        "successPathPrefix": "",
        "timeoutSeconds": 15,
        "maxSubmitRequests": 3
      },
      "expectedTenant": "owned-tenant",
      "roles": [
        "administrator"
      ],
      "session": "owned-browser-session",
      "allowedOriginIds": [
        "app"
      ],
      "allowedPathPrefixes": [
        "/"
      ],
      "allowedTransports": [
        "browser"
      ],
      "verification": {
        "status": "verified",
        "method": "owner-assertion",
        "evidence": "Researcher confirmed that this is an owned test account in the authorized environment."
      }
    }
  ]
