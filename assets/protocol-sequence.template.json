{
  "schemaVersion": 1,
  "targets": {
    "framework": {"host": "127.0.0.1", "port": "${PORT}"}
  },
  "sessions": {
    "attacker": {"role": "user", "tenant": "attacker", "cookies": {}, "variables": {}},
    "victim": {"role": "user", "tenant": "victim", "cookies": {}, "variables": {}}
  },
  "stateModel": {
    "initialState": "fresh",
    "transitions": [
      {
        "stepId": "baseline",
        "from": "fresh",
        "to": "baseline-observed",
        "operation": "read the owned baseline",
        "authorityBefore": "anonymous",
        "authorityAfter": "anonymous",
        "ownershipBefore": "no retained response",
        "ownershipAfter": "researcher-owned observation",
        "invariant": "the baseline must not consume another principal's state"
      }
    ],
    "requiredTransitionPairs": [["fresh", "baseline-observed"]],
    "reductionMustPreserve": ["the baseline remains the first operation"]
  },
  "steps": [
    {
      "id": "baseline",
      "target": "framework",
      "session": "victim",
      "request": {"method": "GET", "path": "/", "headers": []},
      "assertions": [{"kind": "status", "equals": 200}]
    }
  ]
}
